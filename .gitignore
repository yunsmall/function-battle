# 构建产物（build/、build-linux/ 等）
build*/

# 本地开发中间产物：验尸/验证脚本、截图、临时数据
tmp/

# 代码审查报告（开发过程材料，不进库）
review/

# Python 缓存
__pycache__/
*.pyc

# 调参运行产物（日志与续跑状态；ai_tune_result.json 是结论、要进库）
scripts/ai_tune.log
scripts/ai_tune_resume.json

# 对局信箱运行时文件（fg_play.py 自己生成）
scripts/session/

# 编辑器与系统杂项
.vs/
.idea/
.vscode/
*.user
Thumbs.db
desktop.ini
